EFI_ENVIRONMENT=production
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PIX_KEY=
EFI_P12_BASE64=
# Alternativa se o provedor limitar o tamanho da variável:
EFI_P12_PART_A=
EFI_P12_PART_B=
EFI_P12_PART_C=
PORT=3000

# Aviso de leads por SMTP/Gmail — somente server-side
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
