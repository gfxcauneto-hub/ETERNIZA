{
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/pix/create", "destination": "/api/pix/create" },
    { "source": "/api/pix/status/:txid", "destination": "/api/pix/status/:txid" }
  ]
}
